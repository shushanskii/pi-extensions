{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	// A group given as a severity string enables EVERY rule of that group at that severity,
	// which is what "strict" means here: no stable rule of Biome runs at a level a commit can
	// walk past. Nursery stays off — those rules are unstable and change severity between
	// releases. Warnings do not fail the run by themselves, so `npm run lint` passes
	// --error-on-warnings too; together the two leave nothing between "reported" and "red".
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		// npm writes package-lock.json in its own formatting; excluding it keeps
		// `npm install` and `biome check --write` from fighting over it every install.
		"includes": ["**", "!**/package-lock.json"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"enabled": true,
		// Framework domains stay off. `linter.rules` below opens whole groups, and a group opened
		// by severity also turns on the rules that belong to a framework — Qwik's $, React's hooks,
		// Tailwind's class checks. Nothing here is a framework: they would report errors about code
		// that does not exist.
		"domains": {
			"astro": "none",
			"drizzle": "none",
			"next": "none",
			"playwright": "none",
			"project": "none",
			"react": "none",
			"reactNative": "none",
			"solid": "none",
			"svelte": "none",
			"tailwind": "none",
			"tanstackQuery": "none",
			"test": "none",
			"turborepo": "none",
			"types": "none",
			"vue": "none",
			"qwik": "none"
		},
		"rules": {
			"preset": "all",
			"nursery": "off",
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"performance": "error",
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	// Exceptions. Each one is a rule this repository cannot obey without ceasing to be what it
	// is. A rule switched off without that sentence is a rule someone switches back on and then
	// spends an evening rediscovering.
	"overrides": [
		{
			"includes": ["**"],
			"linter": {
				"rules": {
					"style": {
						// pi loads the files listed in `pi.extensions` and calls their default export.
						"noDefaultExport": "off",
						// A token may arrive from the environment; reading it is the documented setup,
						// not a secret leaking into source.
						"noProcessEnv": "off",
						// Length is a metric; see the complexity block below.
						"noExcessiveLinesPerFile": "off"
					},
					"correctness": {
						// These extensions are Node processes: they read config files, spawn `afplay` and
						// talk to localhost over `node:http`. The rule wants dynamic imports so a browser
						// bundle does not pull Node in; nothing here is bundled for a browser.
						"noNodejsModules": "off",
						// Same reasoning: `process.platform` and `process.env` are how an extension finds
						// the machine it runs on.
						"noProcessGlobal": "off"
					},
					"complexity": {
						// Size and shape metrics. `npm run report` (fallow health, dupes) already owns
						// these numbers and prints them without failing anything; two owners of one
						// threshold means it gets tuned until both agree, which is how a metric dies.
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveLinesPerFunction": "off",
						"useMaxParams": "off"
					}
				}
			}
		}
	]
}
