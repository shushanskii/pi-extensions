{
  "baseUrl": "https://llm.rezolver-zero.com/v1",
  "model": "qwen-image-turbo",
  "size": "1024x1024",
  "format": "png",
  "cfgScale": 6.0,
  "loras": {
    "f23gg/NSFW-Qwen-Lora.safetensors": {
      "useWhen": "the prompt is NSFW and needs a pose or anatomy the base model fumbles — positions, cum, anatomy",
      "notFor": "sfw scenes and plain portraits, where it changes nothing",
      "conflictsWith": ["Oliver577/NSFW-Qwen-by-TheseAlpacas-V2.safetensors"],
      "weight": [0.8, 1],
      "source": "https://civitai.com/api/v1/models/2958918"
    },
    "Oliver577/NSFW-Qwen-by-TheseAlpacas-V2.safetensors": {
      "useWhen": "the same TheseAlpacas training as f23gg/NSFW-Qwen-Lora, re-released as V2 — blowjobs, cowgirl, doggy, anal, cum",
      "notFor": "sfw scenes; and not beside the f23gg file, which is one epoch of the same run",
      "conflictsWith": ["f23gg/NSFW-Qwen-Lora.safetensors"],
      "weight": 0.8,
      "trigger": "nsfw",
      "source": "https://huggingface.co/Oliver577/NSFW-Qwen-by-TheseAlpacas-V2"
    },
    "perpetual3x/Genitalia-Anatomy-2.1-v1.safetensors": {
      "useWhen": "genital anatomy for adult female or male subjects, in generation and in image editing",
      "notFor": "clothed or sfw frames — it adds anatomy the prompt did not ask for",
      "weight": 1,
      "trigger": "zl_private_v1",
      "source": "https://huggingface.co/perpetual3x/Qwen-Image-Genitalia-Anatomy-Fix-NSFW-LoRA-v1"
    },
    "tawsLoRa/qwen2_1-femaledVaginus-nsfw-v1_3-fine_L22-31.safetensors": {
      "useWhen": "female genitalia, breasts and male anatomy in any skin colour; v1.3b is the sharper build, layers 22-31 muted",
      "notFor": "sfw frames; and not stacked with another anatomy LoRA without comparing seeds first",
      "weight": [0.7, 1],
      "source": "https://civitai.com/api/v1/models/2986844"
    },
    "PromptPotamus/qwen21_fullbody_pass2_fp16.safetensors": {
      "useWhen": "the frame is full body and the pelvis gets cropped away or smeared; the card says the LoRA has no trigger word",
      "notFor": "portraits and half-frames, where there is no pelvis to fix",
      "weight": 0.8,
      "source": "https://civitai.com/api/v1/models/2983070"
    },
    "Danrisi/lenovo_qwen21.safetensors": {
      "useWhen": "any subject that should look photographed — the author's photoreal style; the card asks for cfg 3-4, down to 1 once the image turns to slop, with a beta scheduler (res_2s best quality, res_2m balanced, multistep fastest)",
      "notFor": "anime and stylised frames; and not at the cfg 6 this config carries, which is past what the card endorses",
      "source": "https://civitai.com/api/v1/models/1662740"
    },
    "chatrlabs/chatrlabs-omni-lora-v0.1-bf16.safetensors": {
      "useWhen": "uncensoring the base with one adapter that covers text-to-image and editing at once; the card's own settings are strength 1.0, 35 steps, true cfg 5.0, negative prompt a single space",
      "notFor": "a pose the narrower files were trained for — f23gg and Oliver577 for poses, perpetual3x and tawsLoRa for anatomy; and untested here, because the card evaluated 35 steps while this entry samples 8",
      "weight": 1,
      "source": "https://huggingface.co/chatrlabs/Qwen-Image-2.1-Uncensored-Omni-LoRA-v0.1"
    },
    "Danrisi/nicegirls_v2_qwen21.safetensors": {
      "useWhen": "the subject is a woman and the frame wants the author's second dataset; the card names lenovo_qwen21 as a pairing that works",
      "notFor": "male-only and non-person frames",
      "source": "https://civitai.com/api/v1/models/1862761"
    },
    "AusBoss/qwen-image-2.1-consistency.safetensors": {
      "useWhen": "editing a picture without the subject drifting — the card's wording is \"stops the drift and keeps Qwen's own look\", step 1500, with a tighter step-2000 build on Hugging Face",
      "notFor": "plain text-to-image: it is an edit-path adapter, so it works only through image, initImage or mask",
      "source": "https://civitai.com/api/v1/models/2969143"
    },
    "AusBoss/qwen-image-2.1-restore.safetensors": {
      "useWhen": "2.1's own upscale is too harsh — the card says it softens the grit, keeps detail and adds less makeup than the base does, step 1500, with a step-1250 build carrying more skin texture on Hugging Face",
      "notFor": "text-to-image, and frames that already need sharpening",
      "source": "https://civitai.com/api/v1/models/2989697"
    },
    "AHEKOT/VNCCS_QI2_PoseStudioV3.safetensors": {
      "useWhen": "posing a character — v3's card claims improved transparent images and steadier multi-character generation",
      "source": "https://civitai.com/api/v1/models/2957080"
    }
  },
  "dir": "~/Pictures/pi",
  "timeoutMs": 900000,
  "open": false
