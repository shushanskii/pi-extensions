{
	"name": "pi-extensions",
	"private": true,
	"description": "The lab's pi extensions, one npm package each, published to GitHub Packages",
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm run analyze && npm test",
		"test": "vitest run --project rpc --project unit",
		"test:tui": "vitest run --project tui",
		"typecheck": "tsc -p . && tsc -p packages/pi-navigator",
		"lint": "biome check --error-on-warnings --max-diagnostics=none .",
		"fix": "biome check --write .",
		"analyze": "fallow architecture --fail-on-issues && fallow dead-code --fail-on-issues",
		"report": "fallow dupes; fallow health; exit 0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@microsoft/tui-test": "^0.1.1",
		"@types/node": "^22",
		"fallow": "^3.37.0",
		"typebox": "1.4.3",
		"typescript": "^5",
		"vitest": "^5.0.5"
	}
}
